---
import { Image } from "astro:assets";
import { readFile } from "node:fs/promises";

const { post } = Astro.props;
function fm(p: any) {
  return p.frontmatter ?? p.data ?? {};
}
function fmtDate(d: string | Date) {
  try {
    return new Date(d).toLocaleDateString("en-GB");
  } catch {
    return String(d ?? "");
  }
}

// Import all project images
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);

// Map of project slugs to folder names (when they differ)
const folderMap: Record<string, string> = {
  koktailiusmaskinius: "koktailius",
  mandelpage: "mandel",
};

const f = fm(post);

// Get word count and calculate reading time (average 200 words per minute)
const raw = (await readFile(post.file, "utf-8")) ?? post.body ?? "";
const content = raw
  // remove frontmatter
  .replace(/^---[\s\S]*?---/, "")
  // remove MDX imports / exports
  .replace(/^(import|export)\s.+$/gm, "")
  // remove HTML / JSX tags
  .replace(/<[^>]+>/g, " ")
  // remove markdown images ![alt](src)
  .replace(/!\[[^\]]*\]\([^)]+\)/g, " ")
  // normalize whitespace
  .replace(/\s+/g, " ")
  .trim();

const wordCount = content
  .split(/\s+/)
  .filter((w: string) => w.length > 0).length;
const readingTime = Math.max(1, Math.round(wordCount / 200));

const title = f.title ?? post.slug ?? post.id ?? "";
const firstChar = title.charAt(0).toUpperCase();
const hasImage = !!f.image;

// Resolve thumbnail image
let thumbnailImage: ImageMetadata | null = null;
if (f.image) {
  const projectSlug = post.url?.split("/").filter(Boolean).pop() || "";
  const folderName =
    folderMap[projectSlug.toLowerCase()] || projectSlug.toLowerCase();
  const imageKey = `/src/assets/projects/${folderName}/${f.image}`;
  thumbnailImage = images[imageKey]?.default || null;
}
---

<a href={post.url} class="item">
  <div class="imgBox">
    {
      thumbnailImage ? (
        <Image
          src={thumbnailImage}
          alt={title}
          width={416}
          class="img"
          loading="lazy"
        />
      ) : hasImage ? (
        <img class="img" src={f.image} loading="lazy" />
      ) : (
        <div class="initial">{firstChar}</div>
      )
    }
  </div>
  <div class="info">
    {
      hasImage ? (
        <div class="widthBox wide">
          <div class="title">{title}</div>
          <div class="date">{fmtDate(f.date)}</div>
        </div>
      ) : (
        <div class="widthBox">
          <div class="title">{title}</div>
          <div class="date">{fmtDate(f.date)}</div>
        </div>
      )
    }
    <div class="category">{f.category}</div>
    <div class="read">({readingTime} min read)</div>
  </div>
</a>

<style>
  .item {
    display: flex;
    justify-content: space-between;
    padding: 0.5em;

    overflow: hidden;
  }

  .item:hover .title {
    text-decoration: underline;
  }

  .info {
    display: flex;
    flex-direction: column;
    padding-left: 0.5em;
    padding-right: 0.5em;

    width: 100%;
  }

  .widthBox {
    display: flex;
    justify-content: space-between;
  }

  @media (max-width: 500px) {
    .wide {
      flex-direction: column;

      .date {
        color: var(--color-text) !important;
        transform: translateY(0);
      }
    }
  }

  @media (max-width: 350px) {
    .widthBox {
      flex-direction: column;

      .date {
        color: var(--color-text) !important;
        transform: translateY(0);
      }
    }
  }

  .imgBox {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    padding: 1px 0;
  }

  .img {
    width: 13em;
    max-width: 43vw;
    min-height: 4em;
    height: auto;
    object-fit: cover;

    border-radius: 0.3em;
    box-shadow: 0 0 0.2em var(--color-shadow);
  }

  .initial {
    font-family: "Goudy Initialen";
    font-size: 6em;
    line-height: 0.8em;
    color: var(--color-text-blockquote);
  }

  .item:hover .initial {
    color: var(--color-text);
  }

  .item:hover .img {
    box-shadow: 0 0 0.6em var(--color-accent);
  }

  .title {
    font-family: "Times New Roman", Times, serif;
    font-size: 1.1em;
    font-weight: bold;
    color: var(--color-accent);
    margin-right: 1em;
  }

  .category {
    font-size: 0.9em;
  }

  .read {
    font-size: 0.9em;
    color: var(--color-bg-dark);
  }

  .date {
    font-family: "Times New Roman", Times, serif;
    font-size: 0.9em;
    color: var(--color-bg-dark);
    transform: translateY(0.25em);
  }
</style>
